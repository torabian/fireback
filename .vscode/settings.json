{
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "cmd": "${workspaceFolder}/artifacts/fireback/f emi strings --langs en,pl --path ${file}",
        "match": "strings-([a-z][a-z]).yml$"
      },
      {
        "cmd": "${workspaceFolder}/artifacts/fireback/f emi compile --path ${relativeFile}",
        "match": "\\.emi.yml$"
      }
    ]
  },
  "yaml.schemas": {
    ".jsonschemas/module3-json-schema.json": ["*Module3.yml"],
    "./.vscode/emi-module-spec.json": ["*.emi.yml", "*.emi.yaml"],
    "./modules/fireback/module3-json-schema.json": ["*Module3.yml"]
  }
}
