{
  "name": "@fireback/react-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Shared hooks and common UI components for Fireback's React admin panel - moved out of @fireback/react-sdk so its feature modules (selfservice, manage, messaging, ...) and any other consuming app import them from one place instead of each keeping their own copy. Ships as raw TS/TSX source (no build step), same as @fireback/react-sdk.",
  "type": "module",
  "exports": {
    "./*": "./*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@devexpress/dx-react-grid": "^4.0.3",
    "@devexpress/dx-react-grid-bootstrap4": "^4.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "@tinymce/tinymce-react": "^4.3.0",
    "buffer": "^6.0.3",
    "classnames": "^2.3.2",
    "formik": "^2.2.9",
    "lodash": "^4.17.21",
    "lucide-react": "^0.484.0",
    "moment": "^2.30.1",
    "qs": "^6.14.0",
    "react-currency-input-field": "^3.6.11",
    "react-data-grid": "^7.0.0-beta.50",
    "react-date-range": "^2.0.1",
    "react-datetime": "^3.3.1",
    "react-dropzone": "^14.2.3",
    "react-google-recaptcha": "^3.1.0",
    "react-modern-drawer": "^1.4.0",
    "react-phone-number-input": "^3.4.12",
    "react-resizable-panels": "^3.0.3",
    "react-router-dom": "^6.9.0",
    "react-select": "^5.7.2",
    "react-toastify": "^9.1.3",
    "react-virtualized-auto-sizer": "^1.0.20",
    "react-window": "^1.8.9",
    "react-window-infinite-loader": "^1.0.9"
  }
}
